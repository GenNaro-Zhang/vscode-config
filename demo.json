{
  "breadcrumbs.filePath": "on",
  "breadcrumbs.symbolSortOrder": "position",
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.tips.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "code-runner.runInTerminal": true,
  "codingcopilot.enableCodelens": false,
  "codingcopilot.enableFloatShortcut": false,
  "commentTranslate.hover.enabled": true,
  "commentTranslate.maxTranslationLength": 1000,
  "commentTranslate.source": "Bing",
  "commentTranslate.targetLanguage": "zh-CN",
  "css.enabledLanguages": ["vue", "jsx", "html"],
  "css.lint.duplicateProperties": "warning",
  "css.lint.propertyIgnoredDueToDisplay": "ignore",
  "css.lint.unknownAtRules": "ignore",
  "css.lint.unknownProperties": "ignore",
  "css.lint.validProperties": [
    "dominant-baseline",
    "alignment-baseline",
    "vertical-align"
  ],
  "css.lint.vendorPrefix": "ignore",
  "css.styleSheets": [
    "src/**/*.css",
    "styles/*.css",
    "style/*.css",
    "css/*.css"
  ],
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "JetBrains Mono Regular, JetBrainsMono-Regular, 'Consolas', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.guides.bracketPairs": "active",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.unicodeHighlight.includeStrings": false,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "emmet.preferences": {},
  "emmet.triggerExpansionOnTab": true,
  "eslint.rules.customizations": [],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.css": "$(capture).css.map, $(capture).*.css",
    "*.js": "$(capture).js.map, $(capture).*.js, $(capture)_*.js",
    "*.jsx": "$(capture).js, $(capture).*.jsx, $(capture)_*.js, $(capture)_*.jsx",
    "*.module.ts": "$(capture).resolver.ts, $(capture).controller.ts, $(capture).service.ts",
    "*.ts": "$(capture).js, $(capture).d.ts.map, $(capture).*.ts, $(capture)_*.js, $(capture)_*.ts",
    "*.tsx": "$(capture).ts, $(capture).*.tsx, $(capture)_*.ts, $(capture)_*.tsx",
    "*.vue": "$(capture).*.ts, $(capture).*.js, $(capture).story.vue",
    "AGENTS.md": "CLAUDE.*, GEMINI.*, CURSOR.*, .cursorrules, .copilot-instructions.*",
    "firebase.json": ".firebaserc, firestore.*, storage.rules, database.rules.json",
    "Gemfile": "Gemfile.lock",
    "package.json": ".browserslist*, .circleci*, .commitlint*, .cz-config.js, .czrc, .dlint.json, .dprint.json, .editorconfig, .eslint*, .flowconfig, .github*, .gitlab*, .gitpod*, .huskyrc*, .jslint*, .lintstagedrc*, .markdownlint*, .node-version, .nodemon*, .npm*, .nvmrc, .pm2*, .pnp.*, .pnpm*, .prettier*, .releaserc*, .sentry*, .stackblitz*, .styleci*, .stylelint*, .tazerc*, .textlint*, .tool-versions, .travis*, .versionrc*, .vscode*, .watchman*, .xo-config*, .yamllint*, .yarnrc*, Procfile, apollo.config.*, appveyor*, azure-pipelines*, bower.json, build.config.*, commitlint*, crowdin*, dangerfile*, dlint.json, dprint.json, grunt*, gulp*, jenkins*, lerna*, lint-staged*, nest-cli.*, netlify*, nodemon*, nx.*, package-lock.json, package.nls*.json, phpcs.xml, pm2.*, pnpm*, prettier*, pullapprove*, pyrightconfig.json, release-tasks.sh, renovate*, rollup.config.*, stylelint*, tslint*, tsup.config.*, turbo*, typedoc*, unlighthouse*, vercel*, vetur.config.*, webpack*, workspace.json, xo.config.*, yarn*",
    "tsconfig.json": "tsconfig.*.json",
    "vite.config.*": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, histoire.config.*, htmlnanorc.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, playwright.config.*, postcss.config.*, puppeteer.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, unocss.config.*, vitest.config.*, webpack.config.*, windi.config.*",
    "vue.config.*": "*.env, .babelrc*, .codecov, .cssnanorc*, .env.*, .envrc, .htmlnanorc*, .lighthouserc.*, .mocha*, .postcssrc*, .terserrc*, api-extractor.json, ava.config.*, babel.config.*, contentlayer.config.*, cssnano.config.*, cypress.*, env.d.ts, formkit.config.*, formulate.config.*, histoire.config.*, htmlnanorc.*, jasmine.*, jest.config.*, jsconfig.*, karma*, lighthouserc.*, playwright.config.*, postcss.config.*, puppeteer.config.*, svgo.config.*, tailwind.config.*, tsconfig.*, tsdoc.*, unocss.config.*, vitest.config.*, webpack.config.*, windi.config.*"
  },
  "files.associations": {
    "*.js": "javascript",
    "*.rules": "firestorerules"
  },
  "files.autoSave": "onWindowChange",
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.defaultLanguage": "${activeEditorLanguage}",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.nextEditSuggestions.enabled": false,
  "gitlens.advanced.messages": {
    "suppressGitDisabledWarning": true,
    "suppressGitMissingWarning": true
  },
  "html.format.unformatted": "",
  "js/ts.implicitProjectConfig.checkJs": true,
  "js/ts.preferences.organizeImports": {},
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "json.schemas": [
    {
      "fileMatch": ["**/package.json"],
      "url": ".vscode/stylelintrc.json"
    },
    {
      "fileMatch": ["**/check.json"],
      "url": "https://coderabbit.ai/integrations/schema.v2.json"
    }
  ],
  "less.compile": {
    "out": "${workspaceRoot}/css/"
  },
  "less.lint.vendorPrefix": "ignore",
  "liveServer.settings.CustomBrowser": "chrome",
  "liveServer.settings.donotShowInfoMsg": true,
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  "prettier.arrowParens": "avoid",
  "security.workspace.trust.untrustedFiles": "open",
  "svgPreview.autoOpen": false,
  "tailwindCSS.includeLanguages": {
    "plaintext": "html"
  },
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorStyleInactive": "block",
  "terminal.integrated.enableImages": false,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.suggest.insertTrailingSpace": false,
  "terminal.integrated.suggest.providers": {
    "lsp": true,
    "vscode.terminal-suggest": true
  },
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on",
    "unknown": "off"
  },
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "never",
  "window.density.editorTabHeight": "default",
  "window.zoomPerWindow": false,
  "workbench.activityBar.compact": true,
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "One Dark Pro",
  "workbench.editor.editorActionsLocation": "default",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "default",
  "workbench.editorAssociations": {
    "*.db": "default",
    "*.sass": "default",
    "*.html": "codebuddy.html.previewEditor",
    "*.htm": "codebuddy.html.previewEditor"
  },
  "workbench.fontAliasing": "default",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.settings.applyToAllProfiles": ["explorer.fileNesting.patterns"],
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 22,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.view.alwaysShowHeaderActions": true,
  "files.autoGuessEncoding": true,
  "terminal.integrated.initialHint": false,
  "codingcopilot.enableInlineChat": true,
  "codingcopilot.enableInlineChatIDEShortcutsTip": false,
  "codingcopilot.commitMessageStyle": "Auto",
  "codingcopilot.commitMessageLanguage": "zh_CN",
  "codingcopilot.toolbarOnSelection": false,
  "codingcopilot.enableAutoCompletions": true,
  "codingcopilot.enableNextEditSuggestions": true,
  "codingcopilot.generationPreference": "intelligentMode",
  "codingcopilot.selectedCompletionModel": "",
  "codingcopilot.enableCompletionLanguage": {
    "scmInput": false
  },
  "codingcopilot.enableIDENotification": true,
  "codingcopilot.customBlacklistCommands": [],
  "codingcopilot.disabledSecurityCategories": [
    "injection",
    "scriptExec",
    "powershell"
  ],
  "terminal.integrated.suggest.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "never"
}
